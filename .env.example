# Configuración pública del cliente Firebase
# Copia este archivo como .env.local y completa los valores del proyecto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Región de Cloud Functions
VITE_FUNCTIONS_REGION=us-central1

# Respaldo Base64 en Firestore si Storage falla. Solo se aplica en desarrollo;
# el build de producción lo desactiva siempre. Límites: 180 KB por imagen y
# 600 KB en total. Si las fotos no caben, no se publica nada y se muestra error.
VITE_ALLOW_BASE64_FALLBACK=false

# Endpoint PHP opcional de contingencia para el formulario de contacto.
# Ejemplo: /mail/contact.php
VITE_CONTACT_FALLBACK_URL=

# Número de WhatsApp de Manuela en formato internacional, solo dígitos.
# Ejemplo: 573001234567 (sin +, espacios ni guiones).
# Si está vacío, el CTA "Habla con Manu" no se muestra.
VITE_WHATSAPP_NUMBER=
