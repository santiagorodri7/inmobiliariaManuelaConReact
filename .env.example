# Configuración pública del cliente Firebase.
# La app incluye una configuración pública por defecto en
# src/config/firebasePublic.js. Estas variables son opcionales y solo se
# necesitan para apuntar a otro proyecto de Firebase; si se definen, tienen
# prioridad sobre la configuración incluida.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Región de Cloud Functions
VITE_FUNCTIONS_REGION=us-central1

# Solo desarrollo: conecta Auth, Firestore y Storage al emulador local.
VITE_USE_FIREBASE_EMULATORS=false

# URL del backend FastAPI. Vacío usa el proxy de Vite /api en desarrollo.
VITE_SIMULATION_API_URL=

# Respaldo Base64 en Firestore si Storage falla. Está activo por defecto.
# Usa false para desactivarlo. Límites: 180 KB por imagen y 600 KB en total.
# Si las fotos no caben, no se publica nada y se muestra error.
VITE_ALLOW_BASE64_FALLBACK=true

# Endpoint PHP opcional de contingencia para el formulario de contacto.
# Ejemplo: /mail/contact.php
VITE_CONTACT_FALLBACK_URL=

# Número de WhatsApp de Manuela en formato internacional, solo dígitos.
# Ejemplo: 573001234567 (sin +, espacios ni guiones).
# Sobrescribe el número confirmado en src/config/contact.js. Si se deja vacío,
# la app usa el número de ese archivo.
VITE_WHATSAPP_NUMBER=
