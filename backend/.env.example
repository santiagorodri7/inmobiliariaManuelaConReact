# Backend FastAPI para los reportes del simulador.
# Copia este archivo como backend/.env y ajusta los valores.

# Carpeta raíz del proyecto Python que contiene data/limpios y data/sucios.
# Por defecto apunta a integrador_nt_Manuela_Bermudez_Reaktor en la raíz.
# Debe tener permisos de escritura para que funcione POST /rerun.
SIMULATION_DIR=

# Intérprete que ejecuta el simulador. Vacío usa el mismo Python de FastAPI.
SIMULATION_PYTHON=

# Tiempo máximo de una regeneración completa, en segundos.
SIMULATION_TIMEOUT_SECONDS=120

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Si se define, el API exige un ID token de Firebase con rol Admin.
# Si queda vacío, el API funciona sin autenticación (solo desarrollo local).
FIREBASE_PROJECT_ID=

# Ruta al JSON de la cuenta de servicio. Si está vacío se usan las
# credenciales por defecto de la aplicación.
FIREBASE_SERVICE_ACCOUNT=

# Solo para pruebas con el emulador de Firebase Auth.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
