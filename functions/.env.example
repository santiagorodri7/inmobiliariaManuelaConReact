# Región de las funciones. Debe coincidir con VITE_FUNCTIONS_REGION.
FUNCTIONS_REGION=us-central1

# Provedor SMTP para el formulario de contacto.
# Gmail requiere una contraseña de aplicación, no la contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Destinatario y remitente visibles del correo.
CONTACT_TO=manuelabermudezrealestate@gmail.com
CONTACT_FROM=

# Opcional: bucket explícito para el borrado definitivo de imágenes.
# STORAGE_BUCKET=registrologininmobiliaria.appspot.com

# Activar cuando App Check esté configurado en la consola de Firebase.
ENFORCE_APP_CHECK=false
