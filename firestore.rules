rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function canonicalUserDocument(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function legacyUserDocument(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function hasCanonicalUser(uid) {
      return exists(canonicalUserDocument(uid));
    }

    // El rol puede vivir en la colección nueva `users` o en la heredada
    // `usuarios`. Si existe el documento nuevo, ese rol tiene prioridad.
    function isAdmin() {
      return isSignedIn() && (
        (hasCanonicalUser(request.auth.uid)
          && get(canonicalUserDocument(request.auth.uid)).data.rol
            in ['Admin', 'Administrador'])
        || (!hasCanonicalUser(request.auth.uid)
          && exists(legacyUserDocument(request.auth.uid))
          && get(legacyUserDocument(request.auth.uid)).data.rol
            in ['Admin', 'Administrador'])
      );
    }

    function isActiveProfile(path) {
      return exists(path) && (
        !get(path).data.keys().hasAny(['activo'])
        || get(path).data.activo != false
      );
    }

    function isActiveUser() {
      return isSignedIn() && (
        (hasCanonicalUser(request.auth.uid)
          && isActiveProfile(canonicalUserDocument(request.auth.uid)))
        || (!hasCanonicalUser(request.auth.uid)
          && isActiveProfile(legacyUserDocument(request.auth.uid)))
      );
    }

    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validDigits(value, min, max) {
      return value is string
        && value.size() >= min
        && value.size() <= max
        && value.matches('^[0-9]+$');
    }

    function validDateString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validFinancialData(data) {
      return data.estadoCivil in [
          'soltero',
          'casado',
          'union_libre',
          'divorciado',
          'viudo'
        ]
        && data.tipoContrato in [
          'indefinido',
          'fijo',
          'prestacion_servicios',
          'independiente',
          'pensionado',
          'otro'
        ]
        && data.ingresosMensuales is number
        && data.ingresosMensuales > 0
        && data.ingresosExtras is number
        && data.ingresosExtras >= 0
        && data.aceptaTratamiento == true;
    }

    function validRegistrationData(data) {
      return validText(data.nombre, 2, 120)
        && validDigits(data.cedula, 6, 12)
        && validDateString(data.fechaNacimiento)
        && validText(data.email, 5, 180)
        && data.rol in ['Comprador', 'Vendedor']
        && data.activo == true
        && validFinancialData(data);
    }

    // Solo los inmuebles publicados son legibles sin autenticación.
    // Los documentos heredados sin `status` deben completarse desde el panel
    // administrativo antes de aparecer en el catálogo.
    function isPublicProperty() {
      return resource.data.status == 'disponible';
    }

    function isPropertyOwner(property) {
      return isActiveUser() && property.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // users: perfil canónico. La cédula y los ingresos son datos sensibles:
    // solo el propio usuario o un administrador pueden leerlos.
    // ---------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && validRegistrationData(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'nombre',
          'cedula',
          'fechaNacimiento',
          'email',
          'telefono',
          'direccion',
          'avatar',
          'rol',
          'activo',
          'estadoCivil',
          'tipoContrato',
          'ingresosMensuales',
          'ingresosExtras',
          'aceptaTratamiento',
          'fechaAceptacionTratamiento',
          'preferences',
          'fechaRegistro',
          'createdAt',
          'updatedAt'
        ]);

      // El usuario puede editar datos de contacto y financieros, pero nunca
      // su cédula, correo, rol, estado activo ni el consentimiento.
      allow update: if request.auth.uid == userId
        && (!resource.data.keys().hasAny(['activo']) || resource.data.activo != false)
        && changedFields().hasOnly([
          'nombre',
          'telefono',
          'direccion',
          'avatar',
          'fechaNacimiento',
          'estadoCivil',
          'tipoContrato',
          'ingresosMensuales',
          'ingresosExtras',
          'preferences',
          'updatedAt'
        ])
        && validText(request.resource.data.nombre, 2, 120)
        && validDigits(request.resource.data.cedula, 6, 12)
        && validDateString(request.resource.data.fechaNacimiento)
        && validFinancialData(request.resource.data)
        && request.resource.data.cedula == resource.data.cedula
        && request.resource.data.email == resource.data.email
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo;

      allow update: if isAdmin()
        && changedFields().hasOnly([
          'nombre',
          'cedula',
          'fechaNacimiento',
          'email',
          'telefono',
          'direccion',
          'avatar',
          'rol',
          'activo',
          'estadoCivil',
          'tipoContrato',
          'ingresosMensuales',
          'ingresosExtras',
          'aceptaTratamiento',
          'fechaAceptacionTratamiento',
          'preferences',
          'deactivatedAt',
          'deactivatedBy',
          'fechaRegistro',
          'updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['rol'])
          || request.resource.data.rol in ['Admin', 'Vendedor', 'Comprador'])
        && (!request.resource.data.keys().hasAny(['cedula'])
          || validDigits(request.resource.data.cedula, 6, 12))
        && (!request.resource.data.keys().hasAny(['ingresosMensuales'])
          || (request.resource.data.ingresosMensuales is number
            && request.resource.data.ingresosMensuales >= 0))
        && (!request.resource.data.keys().hasAny(['ingresosExtras'])
          || (request.resource.data.ingresosExtras is number
            && request.resource.data.ingresosExtras >= 0));

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // usuarios: colección heredada. Se mantiene para que las cuentas y el
    // panel administrativo anteriores sigan funcionando. `idioma` ya no se
    // escribe ni se valida: la preferencia vive solo en localStorage.
    // ---------------------------------------------------------------------

    match /usuarios/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.activo == true
        && request.resource.data.rol in ['Comprador', 'Vendedor']
        && validText(request.resource.data.nombre, 2, 120)
        && validText(request.resource.data.email, 5, 180)
        && request.resource.data.keys().hasOnly([
          'nombre',
          'cedula',
          'fechaNacimiento',
          'email',
          'telefono',
          'direccion',
          'avatar',
          'rol',
          'activo',
          'fechaRegistro',
          'createdAt',
          'updatedAt'
        ]);

      // El usuario solo puede editar datos de contacto/perfil. Nunca su rol,
      // su estado activo, su correo ni las fechas de registro.
      allow update: if request.auth.uid == userId
        && (!resource.data.keys().hasAny(['activo']) || resource.data.activo != false)
        && changedFields().hasOnly([
          'nombre',
          'telefono',
          'direccion',
          'avatar',
          'fechaNacimiento',
          'preferences',
          'updatedAt'
        ])
        && validText(request.resource.data.nombre, 2, 120)
        && request.resource.data.email == resource.data.email
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo;

      allow update: if isAdmin()
        && changedFields().hasOnly([
          'nombre',
          'cedula',
          'fechaNacimiento',
          'telefono',
          'direccion',
          'avatar',
          'rol',
          'activo',
          'estadoCivil',
          'tipoContrato',
          'ingresosMensuales',
          'ingresosExtras',
          'aceptaTratamiento',
          'deactivatedAt',
          'deactivatedBy',
          'fechaRegistro',
          'updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['rol'])
          || !changedFields().hasAny(['rol'])
          || request.resource.data.rol in ['Admin', 'Vendedor', 'Comprador']);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // propiedades: lectura pública únicamente de inmuebles publicados.
    // El listado público debe consultar where("status", "==", "disponible").
    // ---------------------------------------------------------------------

    match /propiedades/{propertyId} {
      allow read: if isPublicProperty()
        || isAdmin()
        || isPropertyOwner(resource.data);

      allow create: if (isAdmin()
          || (isActiveUser() && request.resource.data.ownerId == request.auth.uid))
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.status == 'disponible'
        && request.resource.data.operation in ['venta', 'renta']
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && validText(request.resource.data.title, 3, 180)
        && validText(request.resource.data.location, 2, 180)
        && validText(request.resource.data.description, 0, 5000)
        && request.resource.data.get('saleId', '') == ''
        && request.resource.data.get('featured', false) == false
        && !request.resource.data.keys().hasAny(['closedAt']);

      // El propietario puede editar su inmueble mientras no tenga un cierre.
      // Los cambios de estado a vendida/rentada y los cierres los hace un
      // administrador o la transacción de ventas.
      allow update: if isAdmin()
        || (isActiveUser()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && (!resource.data.keys().hasAny(['status'])
            || (resource.data.status != 'vendida' && resource.data.status != 'rentada'))
          && request.resource.data.status in ['disponible', 'inactiva']
          && request.resource.data.get('saleId', '')
            == resource.data.get('saleId', '')
          && request.resource.data.get('featured', false)
            == resource.data.get('featured', false)
          && request.resource.data.get('closedAt', null)
            == resource.data.get('closedAt', null));

      // El borrado definitivo se ejecuta con la Cloud Function protegida.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // propertyViews: contador mensual público. Cualquiera puede crear el
    // documento con views = 1 o sumar exactamente 1. No se permite borrar ni
    // asignar valores arbitrarios.
    // ---------------------------------------------------------------------

    match /propertyViews/{viewId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
          'month',
          'propertyId',
          'views',
          'updatedAt'
        ])
        && validText(request.resource.data.month, 7, 7)
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && validText(request.resource.data.propertyId, 1, 128)
        && request.resource.data.views is number
        && request.resource.data.views == 1;

      allow update: if changedFields().hasOnly(['views', 'updatedAt'])
        && request.resource.data.month == resource.data.month
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.views is number
        && request.resource.data.views == resource.data.views + 1;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // ventas: solo administración.
    // ---------------------------------------------------------------------

    match /ventas/{saleId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'cerrada'
        && request.resource.data.closingValue is number
        && request.resource.data.closingValue > 0
        && validText(request.resource.data.propertyTitle, 1, 180)
        && validText(request.resource.data.buyerName, 3, 160);

      allow update: if isAdmin()
        && changedFields().hasOnly([
          'status',
          'annulledAt',
          'annulledBy',
          'annulReason',
          'updatedAt'
        ])
        && request.resource.data.status in ['cerrada', 'anulada'];

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // testimonios: lectura pública solo de los aprobados/activos.
    // Los testimonios nuevos quedan pendientes hasta que administración los
    // apruebe. El documento público nunca guarda correo ni userId; esos datos
    // viven en `privado/autor`, legible solo por administración.
    // ---------------------------------------------------------------------

    match /testimonios/{testimonialId} {
      allow read: if resource.data.estado in ['activo', 'aprobado']
        || isAdmin();

      allow create: if isActiveUser()
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && validText(request.resource.data.nombre, 2, 100)
        && validText(request.resource.data.texto, 20, 1200)
        && request.resource.data.keys().hasOnly([
          'nombre',
          'profesion',
          'texto',
          'rating',
          'estado',
          'fecha',
          'fechaCreacion'
        ]);

      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /privado/{privateId} {
        allow read: if isAdmin();

        allow create: if privateId == 'autor'
          && (
            isAdmin()
            || (isActiveUser()
              && request.resource.data.userId == request.auth.uid)
          )
          && request.resource.data.keys().hasOnly([
            'userId',
            'createdAt'
          ])
          && validText(request.resource.data.userId, 1, 128);

        allow update, delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------------
    // auditLog: escritura de acciones propias, lectura administrativa.
    // ---------------------------------------------------------------------

    match /auditLog/{entryId} {
      allow read: if isAdmin();

      allow create: if isActiveUser()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action in [
          'createSale',
          'annulSale',
          'publishProperty',
          'hideProperty',
          'softDeleteProperty',
          'reactivateUser',
          'deactivateUser',
          'deleteProperty',
          'hardDeleteProperty',
          'backfillLegacyData',
          'approveTestimonial',
          'rejectTestimonial'
        ]
        && request.resource.data.keys().hasOnly([
          'action',
          'actorId',
          'actorEmail',
          'targetType',
          'targetId',
          'details',
          'createdAt'
        ]);

      allow update, delete: if false;
    }

    // Cualquier colección no definida queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
