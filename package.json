{
  "name": "inmobiliaria-manuela",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-manuela \"node tests/firestore.rules.test.cjs && node tests/storage.rules.test.cjs\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-manuela",
    "seed:demo": "python backend/scripts/seed_demo.py",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage --project demo-manuela \"python backend/scripts/seed_demo.py && playwright test\""
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.1",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "bootstrap": "^5.3.3",
    "firebase": "^10.8.1",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.1",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^5.2.0",
    "firebase-tools": "^15.35.0",
    "vite": "^7.0.0"
  }
}
